# System Logs
LOG_LEVEL=debug

# Discord Configuration
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_application_id_here
DISCORD_GUILD_ID=optional_testing_guild_id_here
WELCOME_CHANNEL_ID=optional_specific_welcome_channel_id_here

# Arcadia API Configuration
API_BASE_URL=https://api.arcadiamc.net

# Database configuration (MySQL/MariaDB)
DB_IP=127.0.0.1
DB_PORT=3306
DB_NAME=arcadia_bot
DB_USER=root
DB_PASSWORD=secret
DB_CONNECTION_LIMIT=10

# Redis configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
