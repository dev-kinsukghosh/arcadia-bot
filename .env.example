# ========================================================
# Arcadia Community Bot — Environment Configuration Template
# Copy this file to .env or run `npm run setup` for automated configuration.
# ========================================================

# ── Runtime & Logging ────────────────────────────────────
# Log level: debug | info | warn | error
LOG_LEVEL=debug
# Mode: development | production | PROD
MODE=development
NODE_ENV=development
# Legacy / text fallback command prefix
BOT_PREFIX=a!

# ── Discord Bot Credentials ──────────────────────────────
# Obtain from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
# Optional: Set a specific Guild ID to instantly deploy slash commands to a test server
DISCORD_GUILD_ID=

# ── Developer Authorization & Telemetry ──────────────────
# Secret token for developer endpoints (/api/dev/*) and maintenance mode bypass.
# Generate a strong key with: npm run keygen
DEV_SECRET=
# Comma-separated Discord User IDs granted developer privileges & admin bypass
DEV_ID=

# ── MySQL / MariaDB Database Configuration ───────────────
DB_IP=127.0.0.1
DB_PORT=3306
DB_NAME=arcadia_bot
DB_USER=root
DB_PASSWORD=secret
DB_CONNECTION_LIMIT=30

# ── Redis Cache Configuration ────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── ArcadiaMC Server API Configuration ───────────────────
API_BASE_URL=https://api.arcadiamc.net
MC_VERSION=1.21.1

# ── Express Web API & Dashboard Configuration ────────────
PORT=5556
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5556
DASHBOARD_URL=http://localhost:5173

# ── Discord Bot Notification & Telemetry Channels (Optional) ──
# Channel IDs where bot logs, suggestions, feedback, and error crash traces will be routed:
ERROR_CHANNEL_ID=
FEEDBACK_CHANNEL_ID=
OUTPUT_CHANNEL_ID=
SUGGEST_CHANNEL_ID=
SYSLOGS_CHANNEL_ID=
