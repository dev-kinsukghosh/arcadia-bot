{
  "name": "arc-community-bot",
  "version": "2.0.3",
  "description": "",
  "main": "bot.js",
  "scripts": {
    "start": "node src/deploy-commands.js --global && node bot.js",
    "start:bot": "node src/deploy-commands.js --global && node bot.js --bot-only",
    "start:server": "node src/server.js",
    "dev": "nodemon bot.js",
    "dev:bot": "nodemon bot.js --bot-only",
    "dev:server": "nodemon src/server.js",
    "dev:all": "run-p dev dashboard:dev",
    "setup": "node scripts/setup.js",
    "deploy": "node src/deploy-commands.js",
    "test": "vitest run",
    "test:env": "vitest run tests/env.test.js",
    "test:api": "vitest run tests/api.test.js",
    "test:db": "vitest run tests/database.test.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:safe": "node scripts/migrate-safe.js",
    "db:studio": "drizzle-kit studio",
    "upload:emojis": "node scripts/upload-emojis.js",
    "dashboard:dev": "vite dashboard --config dashboard/vite.config.mjs",
    "dashboard:build": "node dashboard/prerender.js",
    "dashboard:preview": "vite preview dashboard --config dashboard/vite.config.mjs",
    "dashboard:check": "npm-run-all lint"
  },
  "nodemonConfig": {
    "ignore": [
      "dashboard/*",
      "logs/*",
      "src/icons/*",
      "src/heads/*",
      "tests/*"
    ],
    "delay": 2500
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@napi-rs/canvas": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.18.1",
    "axios-retry": "^4.5.0",
    "chart.js": "^4.5.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "express-slow-down": "^3.1.0",
    "gradient-string": "^3.0.0",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.22.5",
    "picocolors": "^1.1.1",
    "pinia": "^4.0.2",
    "postcss": "^8.5.25",
    "redis-om": "^0.4.7",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.2.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "nodemon": "^3.1.14",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite-plugin-vue-inspector": "^7.0.0",
    "vitest": "^4.1.10"
  }
}
